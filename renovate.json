{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "description": [
    "依赖升级统一由 Renovate 管理（npm 依赖与 Docker 镜像标签）",
    "Dependabot version updates 在仓库设置中关闭，避免两个机器人重复开 PR"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "非大版本升级合并为一个 PR，减少 PR 数量与 rebase 成本",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "非大版本依赖升级",
      "groupSlug": "non-major"
    },
    {
      "description": "锁定 brace-expansion 于 1.x 修复版，避免破坏 CommonJS 及 minimatch 兼容性",
      "matchPackageNames": [
        "brace-expansion"
      ],
      "enabled": false
    },
    {
      "description": "暂不升级 eslint 至 v10，等待 eslint-plugin-import 等生态插件支持",
      "matchPackageNames": [
        "eslint",
        "@eslint/js"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ]
}
